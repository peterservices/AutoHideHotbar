{
  "schemaVersion": 1,
  "id": "autohidehotbar",
  "version": "${version}",
  "name": "${display_name}",
  "description": "${description}",
  "authors": ["${author}", "${credits}"],
  "contact": {},
  "license": "${license}",
  "icon": "assets/autohidehotbar/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.github.peterservices.autohidehotbar.AutoHideHotbarClient"
    ]
  },
  "mixins": [
    "autohidehotbar.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_minimum}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_minimum}",
    "architectury": "~${architectury_minimum}"
  },
  "custom": {
    "mc-publish": {
      "dependencies": [
        "midnightlib@${midnightlib_version}(embedded){modrinth:codAaoxh}{curseforge:488090}",
        "fabric-api(required){modrinth:P7dR8mSH}{curseforge:306612}",
        "architectury(required){modrinth:lhGA9TYQ}{curseforge:419699}"
      ]
    }
  }
}